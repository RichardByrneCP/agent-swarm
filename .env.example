# Required: Cursor API key (user key or team service-account key).
# Get one at https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# Optional model overrides. If PLANNER_MODEL is empty, the tool resolves the
# latest available Opus model from your account at startup.
# PLANNER_MODEL=
# WORKER_MODEL=composer-2.5
# REVIEWER_MODEL=composer-2.5
# RECONCILER_MODEL=composer-2.5

# Optional defaults (all overridable via CLI flags).
# SWARM_MAX_DEPTH=2
# SWARM_MAX_LEAVES=40
# SWARM_CONCURRENCY=4
# SWARM_FIELD_GUIDE_LINES=200
# SWARM_WORKTREE_ROOT=.swarm-worktrees
# SWARM_RUN_ROOT=.swarm-runs
